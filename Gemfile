source 'https://rubygems.org'

group :jekyll_plugins do
  gem 'jekyll', '~> 4.4.1'
  gem 'jekyll-feed'
  gem 'jekyll-sitemap'
  gem 'jekyll-redirect-from'
  gem 'jekyll-gist'
  gem 'jekyll-paginate'
  gem 'jemoji'
end

gem 'kramdown'
gem 'kramdown-parser-gfm'

# Windows does not include the IANA time zone database used by Jekyll.
gem 'tzinfo-data' if Gem.win_platform?
